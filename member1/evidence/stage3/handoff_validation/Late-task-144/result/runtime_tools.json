        "properties": {
          "format": {
            "default": "YYYY-MM-DD HH:mm:ss",
            "description": "The format of the time",
            "enum": [
              "h:mm A",
              "h:mm:ss A",
              "YYYY-MM-DD HH:mm:ss",
              "YYYY-MM-DD",
              "YYYY-MM",
              "MM/DD/YYYY",
              "MM/DD/YY",
              "YYYY/MM/DD",
              "YYYY/MM"
            ],
            "type": "string"
          },
          "timezone": {
            "description": "The timezone of the time, IANA timezone name, e.g. Asia/Shanghai",
